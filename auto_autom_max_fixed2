        States.AutoDanhThuong = Value
    end
})

CombatTab:CreateToggle({
    Name = "Auto Phe Pha V2",
    CurrentValue = false,
    Flag = "AutoPhePha",
    Callback = function(Value)
        States.AutoPhePha = Value
    end
})

CombatTab:CreateToggle({
    Name = "Auto Mode",
    CurrentValue = false,
    Flag = "AutoMode",
    Callback = function(Value)
        States.AutoMode = Value
    end
})

CombatTab:CreateToggle({
    Name = "Auto Lock Atom",
