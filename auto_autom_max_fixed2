
-- AUTO ATOM MAX | RAYFIELD EDITION

local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

-- WINDOW
local Window = Rayfield:CreateWindow({
    Name = "Auto Atom Max",
    LoadingTitle = "Auto Atom Max",
    LoadingSubtitle = "Rayfield Edition",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "RayConfig",
        FileName = "AutoAtomMax"
    },
    Discord = {
        Enabled = false
    },
    KeySystem = false
})

-- TABS
local MainTab = Window:CreateTab("Main", 4483362458)
local CombatTab = Window:CreateTab("Combat", 4483362458)
local DungeonTab = Window:CreateTab("Dungeon", 4483362458)
local MiscTab = Window:CreateTab("Misc", 4483362458)

-- STATE
local States = {
    AutoRangeAtom = false,
    AutoTrinh = false,
    AutoDanhThuong = false,
    AutoPhePha = false,
    AutoEquipTools = false,
    AutoNextArea = false,
    AutoGodmode = false,
    AutoStartDungeon = false,
    AutoMode = false,
    AutoLockAtom = false,
    AutoRestartRaid = false
}

local SelectedTool = 2

-- MAIN
MainTab:CreateSection("Main Settings")

MainTab:CreateLabel("Auto Atom Max")
MainTab:CreateLabel("Rayfield interface loaded successfully")

MainTab:CreateDropdown({
    Name = "Selected Tool",
    Options = {"1", "2", "3", "4", "5", "6"},
    CurrentOption = {"2"},
    Flag = "SelectedTool",
    Callback = function(Options)
        SelectedTool = tonumber(Options[1]) or 2
    end
})

-- COMBAT
CombatTab:CreateSection("Combat Settings")

CombatTab:CreateToggle({
    Name = "Auto Range Atom",
    CurrentValue = false,
    Flag = "AutoRangeAtom",
    Callback = function(Value)
        States.AutoRangeAtom = Value
    end
})

CombatTab:CreateToggle({
    Name = "Auto Trinh",
