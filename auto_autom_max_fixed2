-- MISC
MiscTab:CreateSection("Miscellaneous")

MiscTab:CreateToggle({
    Name = "Auto Equip Tools",
    CurrentValue = false,
    Flag = "AutoEquipTools",
    Callback = function(Value)
        States.AutoEquipTools = Value
    end
})

MiscTab:CreateSection("Character")

MiscTab:CreateToggle({
    Name = "Auto Skill + Godmode V2",
    CurrentValue = false,
    Flag = "AutoGodmode",
    Callback = function(Value)
        States.AutoGodmode = Value
    end
})

-- GLOBAL CONTROLS
MiscTab:CreateSection("Global Controls")

MiscTab:CreateButton({
    Name = "Stop All",
    Callback = function()
        for Name in pairs(States) do
            States[Name] = false
        end

        Rayfield:Notify({
            Title = "Auto Atom Max",
            Content = "All feature states disabled.",
            Duration = 4
        })
    end
})

MiscTab:CreateButton({
    Name = "Show Status",
    Callback = function()
        local Active = 0

        for _, Value in pairs(States) do
            if Value then
                Active += 1
            end
        end

        Rayfield:Notify({
            Title = "Script Status",
            Content = tostring(Active) .. " features enabled.",
            Duration = 4
        })
    end
})

Rayfield:Notify({
    Title = "Auto Atom Max",
    Content = "Rayfield interface loaded successfully!",
    Duration = 5
})
